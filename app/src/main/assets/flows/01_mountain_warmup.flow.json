      "detect": "mountain_hold",
      "correction": "如果膝蓋鎖死，提醒膝蓋保持微微彈性。",
      "runtime": {}
    },
    {
      "state": "TRANSITION",
      "durationMs": 3000,
      "cue": "維持呼吸，準備進入下一個動作。",
      "detect": "ready_for_next_pose",
      "correction": "如果呼吸急促，提醒慢慢吸氣吐氣。",
      "runtime": {}
    }
