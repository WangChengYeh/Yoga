      "runtime": {}
    },
    {
      "state": "MOVEMENT",
      "durationMs": 4000,
      "cue": "吸氣，把脊椎慢慢往上延伸，肩膀放鬆。",
      "detect": "spine_lengthened",
      "correction": "如果肩膀聳起，提醒肩膀往下放鬆。",
      "runtime": {}
