    {
      "state": "HOLD",
      "durationMs": 10000,
      "cue": "再深一點點。每次吐氣讓身體更放鬆，感受大腿後側和下背的伸展。",
      "detect": "forward_hold",
      "correction": "不需要追求深度，維持呼吸比壓更深重要。",
