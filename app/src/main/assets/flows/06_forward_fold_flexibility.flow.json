    {
      "state": "HOLD",
      "durationMs": 10000,
      "cue": "停在這裡。完全放鬆頭頸，讓上半身的重量自然往下，不要用力壓。",
      "detect": "forward_hold",
      "correction": "感覺太緊就退回一點，保持呼吸平穩，讓身體自然放鬆。",
